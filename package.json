{
  "name": "htmlinks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Publish HTML documents and presentations. Keep the link.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "init": "node scripts/init.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "supabase:setup": "node --env-file-if-exists=.env scripts/setup-supabase.mjs && npm run db:migrate",
    "maintenance": "node --env-file-if-exists=.env scripts/maintenance.mjs",
    "check": "node --experimental-strip-types --test src/lib/*.test.ts scripts/skill.test.mjs scripts/setup-supabase.test.mjs",
    "check:integration": "node --env-file-if-exists=.env scripts/verify-integration.mjs",
    "check:skill-install": "node scripts/verify-skill-install.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release.mjs",
    "examples:sync": "node scripts/sync-examples.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "lucide-react": "^0.577.0",
    "next": "^16.4.2",
    "postgres": "^3.4.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "@fontsource/hanken-grotesk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3"
  }
}
