# Prefer node scripts/init.mjs to generate unique local secrets.
POSTGRES_PASSWORD=replace-with-a-random-secret
DATABASE_URL=postgres://hstore:replace-with-a-random-secret@localhost:5439/hstore
HTMLINKS_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
# Public page indexing defaults on only for htmlinks.com/www.htmlinks.com.
# Set 1 to opt in on another HTTPS domain, or 0 for private/staging deployments.
# Shared documents remain noindexed. This is not access control.
# INDEX_PUBLIC_SITE=0
# Override the managed destination in helpers downloaded from this instance:
# MANAGED_URL=https://your-managed-origin
STORAGE_DRIVER=filesystem
STORAGE_PATH=./data/uploads
MAX_UPLOAD_BYTES=10485760
RETENTION_DAYS=7
# Enable only behind a trusted proxy that REPLACES x-forwarded-for.
TRUST_PROXY=0
# Optional managed storage. Bucket must remain private.
# For Supabase + Render, see docs/RENDER.md. Use the Session pooler URI
# for DATABASE_URL, with ?sslmode=require (URL-encode the DB password).
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# Use the legacy service_role JWT, matching the current Storage client.
# The legacy service_role key starts with eyJ and has three dot-separated sections.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=htmlinks
# Run npm run supabase:setup once with these settings to provision storage + DB.
# Optional direct connection for migrations:
# MIGRATION_DATABASE_URL=postgres://...
